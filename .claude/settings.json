{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash test.sh)",
      "Bash(node tests/*)",
      "Bash(node benchmark.js)",
      "Bash(node memory_bench.js)",
      "Bash(node memory_bench2.js)",
      "Bash(python -m http.server:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//home/user/TLCLEDU/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/session-context.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/check-i18n-sync.sh" }
        ]
      }
    ]
  }
}
